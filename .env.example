# Copy this file to .env and fill in the values. Never commit .env.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Change the admin URL to something private (keep the trailing slash).
DJANGO_ADMIN_URL=admin/

# Set to True when a reverse proxy (nginx, Cloudflare, a PaaS) terminates HTTPS.
DJANGO_BEHIND_PROXY=False
DJANGO_SECURE_SSL_REDIRECT=True
# How many proxies append to X-Forwarded-For (0 = none). Used for per-IP rate limits.
TRUSTED_PROXY_COUNT=0

# --- Gmail SMTP -----------------------------------------------------------
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create an App Password: Google Account > Security > App passwords.
# 3. Paste the 16-character app password below (spaces are ignored).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.address@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=Ironleaf Website <your.address@gmail.com>
# Where enquiries are delivered (comma separated). Defaults to EMAIL_HOST_USER.
CONTACT_RECIPIENT_EMAIL=your.address@gmail.com

# --- Contact form bot prevention (optional tuning) -------------------------
CAPTCHA_LENGTH=4
CAPTCHA_TTL_SECONDS=600
CONTACT_MIN_FILL_SECONDS=4
CONTACT_MAX_PER_HOUR=3
CONTACT_MAX_PER_DAY=10
